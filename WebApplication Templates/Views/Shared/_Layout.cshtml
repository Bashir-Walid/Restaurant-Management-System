                                </li>
                                <li>
                                    <a href="#">blog</a>
                                    <ul>
                                        <li><a href="blog-no-sidebar.html">Blog No sidebar</a></li>
                                        <li><a href="blog.html">Blog sidebar</a></li>
                                        <li><a asp-controller="Home" asp-action="ProductDetails">Blog details</a></li>
