                                                <li><a asp-controller="Home" asp-action="Menu">eggs</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">sauces</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">apple juice</a></li>
                                            </ul>
                                        </li>
                                        <li>
                                            <a href="#">menu list 03</a>
                                            <ul>
                                                <li><a asp-controller="Home" asp-action="Menu">milk</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">grape juice</a></li>
