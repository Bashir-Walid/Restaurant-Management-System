                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="footer-area">
        <div class="footer-area-top black-bg pt-95 pb-60">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                @Html.Raw(@Model.Titles.FirstOrDefault(x => x.Keyword == "About Us")?.Title)
                            </div>
                            <div class="footer-about">
                                <p>@Model.About.FirstOrDefault().FooterDesc</p>
                                <div class="footer-map">
                                    <a asp-controller="Home" asp-action="Contact"><i class="ion-ios-location-outline"></i> @Model.SystemSettings.Location</a>
                                </div>
                            </div>
                            <div class="social-icon">
                                <ul>
                                    @foreach(var item in Model.MasterSocialMedia){
                                    <li><a  href="@item.Link"><i class="@item.Icon"></i></a></li>
                                    }
                                    
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                @Html.Raw(@Model.Titles.FirstOrDefault(x => x.Keyword == "contact Us")?.Title)

                            </div>
                            <div class="footer-cont-info">
                       @foreach(var item in Model.MasterContactUs)
                                       {
                                    <div class="single-footer-cont-info">
                                  <div class="cont-info-icon">
                                  <i class="@item.Icon"></i>
                                   </div>
                          <div class="cont-info-content">
                           <a href="@item.Link">@item.Text</a>
                          </div>
                      </div>
                    }
                          </div>
                        </div>
                    </div>
                
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                @Html.Raw(@Model.Titles.FirstOrDefault(x => x.Keyword == "Opening Time")?.Title)

                            </div>
                            <div class="open-time pr-30">
                                <ul>
                                    @foreach (var item in Model.OpeningTime){
                                       @if(@item.IsOpen==true){
                                        <li>@item.Day<span>@item.StartTime - @item.EndTime</span></li>
                                    }
                                   else{
                                            <li>@item.Day<span>Close</span></li>
                                   
                                   }
                                   }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                @Html.Raw(@Model.Titles.FirstOrDefault(x => x.Keyword == "Newsletter")?.Title)

@*                                 <h4>Newsletter</h4>
 *@                            </div>
                            <div class="newsletter-style">
                               <p> @Html.Raw(@Model.Titles.FirstOrDefault(x => x.Keyword == "Newsletter")?.Desc)</p>
    <div id="mc_embed_signup" class="subscribe-form ">
        <form id="mc-embedded-subscribe-form" class="validate" novalidate="" target="_blank" name="mc-embedded-subscribe-form" method="post" asp-controller="Home" asp-action="SendMessage2">
            <div id="mc_embed_signup_scroll" class="mc-form">
                <input class="email" type="email" required="" placeholder="Enter your email" name="Email" value="">
                <div class="mc-news" aria-hidden="true">
                    <input type="hidden" value="" tabindex="-1" name="b_6bbb9b6f5827bd842d9640c82_05d85f18ef">
                </div>
                <div class="clear">
                    <input id="mc-embedded-subscribe" class="button" type="submit" name="subscribe" value="Subscribe">
                </div>
            </div>
        </form>
    </div>
</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom black-bg-2 pb-25 pt-25">
            <div class="container">
                <div class="copyright text-center">
                    <p>@Model.SystemSettings.FooterText</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- all js here -->
    <script src="~/ClinetTemplate/assets/js/vendor/jquery-v1.12.4.min.js"></script>
    <script src="~/ClinetTemplate/assets/js/popper.js"></script>
    <script src="~/ClinetTemplate/assets/js/bootstrap.min.js"></script>
    <script src="~/ClinetTemplate/assets/js/ajax-mail.js"></script>
    <script src="~/ClinetTemplate/assets/js/plugins.js"></script>
    <script src="~/ClinetTemplate/assets/js/main.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>