                                        <li><a href="gallery.html">gallery style 1</a></li>
                                        <li><a href="gallery-2.html">gallery style 2</a></li>
                                        <li><a asp-controller="Home" asp-action="Contact">contact us</a></li>
                                    </ul>
                                </li>
                                <li>
                                    <a asp-controller="Home" asp-action="Menu">menu</a>
                                    <ul>
                                        <li>
                                            <a href="#">menu list 01</a>
                                            <ul>
                                                <li><a asp-controller="Home" asp-action="Menu">salad</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">sandwich</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">bread</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">steak</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">tuna steak</a></li>
                                                <li><a asp-controller="Home" asp-action="Menu">spaghetti </a></li>
                                            </ul>
                                        </li>
                                        <li>
