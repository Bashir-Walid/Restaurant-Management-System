                                <img class="logo-normal" alt="Basmoti Logo" src="@Model?.SystemSettings?.LogoLight" style="max-height:90px;" >

                                <img class="logo-sticky" alt="Basmoti Logo" src="@Model?.SystemSettings?.LogoDark" style="max-height:90px;" >

                            }
