@model WebApplication_Templates.ViewModels.TransactionNewsLetterFullViewModels

@{
    ViewData["Title"] = "Newsletter";
}

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">Newsletter Subscribers</h5>
    </div>

    <div class="card-body">

        @if (!ViewBag.HasAnyRecord)
        {
            <div class="alert alert-info">
                No newsletter subscribers found.
            </div>
        }

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td style="min-width:250px;">

                                <button type="button"
                                        class="btn btn-primary btn-sm btnReply"
                                        data-id="@item.id"
                                        data-email="@item.Email">
                                    Reply
                                </button>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           asp-for="DeleteId"
                                           value="@item.id" />

                                    <a class="btn btn-danger btn-sm btnDelete">
                                        Delete
                                    </a>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<div class="modal fade"
     id="replyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="Reply" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="ReplyId" />

                <div class="modal-header">

                    <h5 class="modal-title">
                        Send Newsletter Reply
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="text"
                               id="ReplyEmail"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Subject
                        </label>

                        <input type="text"
                               name="Subject"
                               id="ReplySubject"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Message
                        </label>

                        <textarea name="Message"
                                  id="ReplyMessage"
                                  class="form-control"
                                  rows="6"
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Send
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnReply").click(function () {

        var id = $(this).data('id');
        var Email = $(this).data('email');

        $("#ReplyId").val(id);
        $("#ReplyEmail").val(Email);

        $("#ReplySubject").val("");
        $("#ReplyMessage").val("");

        var replyModal = new bootstrap.Modal(
        document.getElementById('replyModal')
        );

        replyModal.show();

        });


        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });


        $(".btnDelete").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        });

    </script>
}