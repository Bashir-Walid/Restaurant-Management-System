@model WebApplication_Templates.ViewModels.FeedbackFullViewModels

@{
    ViewData["Title"] = "Feedback";
}

<div class="card mb-4">

    <div class="card-header">
        <h5 class="mb-0">Add / Edit Feedback</h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <form asp-action="CreateOrUpdate"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden" asp-for="id" />
                    <input type="hidden" asp-for="Image" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="form-group mb-3">

                        <label asp-for="Image"
                               class="form-label"></label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control" />

                        <span asp-validation-for="Image"
                              class="text-danger"></span>

                        <img id="Image1"
                             style="max-height:100px; width:auto; object-fit:contain; display:none;"
                             class="rounded border mt-2" />

                    </div>

                    <div class="form-group mb-3">

                        <label asp-for="Name"
                               class="form-label"></label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group mb-3">

                        <label asp-for="Title"
                               class="form-label"></label>

                        <input asp-for="Title"
                               class="form-control" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group mb-3">

                        <label asp-for="Feedbacks"
                               class="form-label"></label>

                        <textarea asp-for="Feedbacks"
                                  class="form-control"
                                  rows="4"></textarea>

                        <span asp-validation-for="Feedbacks"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group form-check mb-3">

                        <label class="form-check-label">

                            <input class="form-check-input"
                                   asp-for="IsActive" />

                            @Html.DisplayNameFor(model => model.IsActive)

                        </label>

                    </div>

                    <div class="form-group">

                        <input type="submit"
                               value="Save"
                               class="btn btn-primary" />

                        <input type="reset"
                               value="Clear"
                               class="btn btn-secondary btnClear" />

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<div class="card">

    <div class="card-header">
        <h5 class="mb-0">Feedback List</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Title</th>
                        <th>Feedback</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image"
                                         style="width:80px; height:80px; object-fit:cover;"
                                         class="rounded border" />
                                }

                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>

                            <td style="min-width:250px;">
                                @Html.DisplayFor(modelItem => item.Feedbacks)
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td style="min-width:230px;">

                                <a class="btn btn-warning btn-sm btnEdit"
                                       data-id="@item.id"
                                       data-isactive="@item.IsActive"
                                       data-image="@item.Image"
                                       data-title="@item.Title"
                                       data-name="@item.Name"
                                       data-feedbacks="@item.Feedbacks">

                                    Edit

                                </a>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           asp-for="DeleteId"
                                           value="@item.id" />

                                    <a class="btn btn-danger btn-sm btnDelete">
                                        Delete
                                    </a>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnEdit").click(function () {

        var id = $(this).data('id');
        var Image = $(this).data('image');
        var Name = $(this).data('name');
        var Title = $(this).data('title');
        var Feedbacks = $(this).data('feedbacks');
        var IsActive = $(this).data('isactive');

        $("#id").val(id);
        $("#Image").val(Image);
        $("#Name").val(Name);
        $("#Title").val(Title);
        $("#Feedbacks").val(Feedbacks);

        $("#IsActive").prop(
        'checked',
        IsActive === true ||
        IsActive === 'True' ||
        IsActive === 'true'
        );

        if (Image) {
        $("#Image1")
        .attr("src", Image)
        .show();
        }

        $("html, body").animate({
        scrollTop: 0
        }, 300);

        });


        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });


        $(".btnDelete").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });


        $(".btnClear").click(function () {

        $("#id").val(0);
        $("#Image").val("");
        $("#Image1").hide();

        });

        });

    </script>
}