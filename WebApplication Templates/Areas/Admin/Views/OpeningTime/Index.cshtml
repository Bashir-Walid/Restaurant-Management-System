@model WebApplication_Templates.ViewModels.OpeningTimeFullViewModels

@{
    ViewData["Title"] = "Opening Time";
}

<div class="card mb-4">

    <div class="card-header">
        <h5 class="mb-0">Add / Edit Opening Time</h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <form asp-area="Admin"
                      asp-controller="OpeningTime"
                      asp-action="CreateOrUpdate"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="id" />

                    <div class="form-group mb-3">

                        <label asp-for="Day"
                               class="form-label"></label>

                        <input asp-for="Day"
                               class="form-control" />

                        <span asp-validation-for="Day"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group mb-3">

                        <label asp-for="StartTime"
                               class="form-label"></label>

                        <input asp-for="StartTime"
                               class="form-control" />

                        <span asp-validation-for="StartTime"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group mb-3">

                        <label asp-for="EndTime"
                               class="form-label"></label>

                        <input asp-for="EndTime"
                               class="form-control" />

                        <span asp-validation-for="EndTime"
                              class="text-danger"></span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <div class="form-check">

                                <input class="form-check-input"
                                       asp-for="IsOpen" />

                                <label class="form-check-label"
                                       asp-for="IsOpen">
                                </label>

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <div class="form-check">

                                <input class="form-check-input"
                                       asp-for="IsActive" />

                                <label class="form-check-label"
                                       asp-for="IsActive">
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="form-group">

                        <input type="submit"
                               value="Save"
                               class="btn btn-primary" />

                        <input type="reset"
                               value="Clear"
                               class="btn btn-secondary btnClear" />

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<div class="card">

    <div class="card-header">
        <h5 class="mb-0">Opening Time List</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead>
                    <tr>
                        <th>Day</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Open / Closed</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Day)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.StartTime)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.EndTime)
                            </td>

                            <td>

                                @if (item.IsOpen)
                                {
                                    <span class="badge bg-success">
                                        Open
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Closed
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td style="min-width:230px;">

                                <a class="btn btn-warning btn-sm btnEdit"
                                       data-id="@item.id"
                                       data-day="@item.Day"
                                       data-starttime="@item.StartTime"
                                       data-endtime="@item.EndTime"
                                       data-isopen="@item.IsOpen"
                                       data-isactive="@item.IsActive">
                                    Edit
                                </a>

                                <form asp-area="Admin"
                                      asp-controller="OpeningTime"
                                      asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                                <form asp-area="Admin"
                                      asp-controller="OpeningTime"
                                      asp-action="Delete"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           asp-for="DeleteId"
                                           value="@item.id" />

                                    <a class="btn btn-danger btn-sm btnDelete">
                                        Delete
                                    </a>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnEdit").click(function () {

        var id = $(this).data('id');
        var Day = $(this).data('day');
        var StartTime = $(this).data('starttime');
        var EndTime = $(this).data('endtime');
        var IsOpen = $(this).data('isopen');
        var IsActive = $(this).data('isactive');

        $("#id").val(id);
        $("#Day").val(Day);
        $("#StartTime").val(StartTime);
        $("#EndTime").val(EndTime);

        $("#IsOpen").prop(
        'checked',
        IsOpen === true ||
        IsOpen === 'True' ||
        IsOpen === 'true'
        );

        $("#IsActive").prop(
        'checked',
        IsActive === true ||
        IsActive === 'True' ||
        IsActive === 'true'
        );

        $("html, body").animate({
        scrollTop: 0
        }, 300);

        });


        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });


        $(".btnDelete").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });


        $(".btnClear").click(function () {

        $("#id").val(0);

        });

        });

    </script>
}